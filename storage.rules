rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email;
    }
    function owner() {
      return signedIn() && email() == 'tranquanghai@tdtu.edu.vn';
    }
    function participant() {
      return signedIn() && (email().matches('^[^@]+@(student\\.)?tdtu\\.edu\\.vn$')
        || firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email)));
    }
    function highAdmin() {
      return owner() || (signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(email()))
        && firestore.get(/databases/(default)/documents/admins/$(email())).data.role == 'admin');
    }
    function admin() {
      return owner() || (signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(email())));
    }
    function managesSession(sessionId) {
      return highAdmin() || (admin()
        && firestore.get(/databases/(default)/documents/admins/$(email())).data.role == 'subadmin'
        && firestore.get(/databases/(default)/documents/attendanceSessions/$(sessionId)).data.createdByUid == request.auth.uid);
    }
    function assigned(sessionId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/scannerAssignments/$(sessionId + '_' + email()))
        && firestore.get(/databases/(default)/documents/scannerAssignments/$(sessionId + '_' + email())).data.active == true;
    }

    match /datasets/{datasetFile} {
      allow read: if participant();
      allow create, update: if highAdmin()
        && datasetFile == 'faculty-students.json.gz'
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType == 'application/gzip';
      allow delete: if owner();
    }

    match /attendance/{sessionId}/{imageFile} {
      allow read: if managesSession(sessionId) || assigned(sessionId);
      allow create, update: if (managesSession(sessionId) || assigned(sessionId))
        && imageFile.matches('^[A-Za-z0-9_.-]+\\.jpg$')
        && request.resource.size < 1536 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if highAdmin();
    }

    match /exports/{exportType}/{exportFile} {
      allow read: if admin();
      allow create, update: if admin()
        && (exportType == 'registrations' || exportType == 'attendance')
        && exportFile.matches('^[A-Za-z0-9_.-]+\\.xlsx$')
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
      allow delete: if highAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
