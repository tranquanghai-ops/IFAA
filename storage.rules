rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email;
    }
    function owner() {
      return signedIn() && email() == 'tranquanghai@tdtu.edu.vn';
    }
    function participant() {
      return signedIn() && (email().matches('^[^@]+@(student\\.)?tdtu\\.edu\\.vn$')
        || firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email)));
    }
    function highAdmin() {
      return owner() || (signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(email()))
        && (firestore.get(/databases/(default)/documents/admins/$(email())).data.get('role', 'admin') == 'admin'
          || firestore.get(/databases/(default)/documents/admins/$(email())).data.get('role', '') == 'high_admin'));
    }
    function admin() {
      return owner() || (signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(email())));
    }
    function exportCacheAdmin() {
      return owner() || (signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(email()))
        && (firestore.get(/databases/(default)/documents/admins/$(email())).data.get('role', 'admin') == 'admin'
          || firestore.get(/databases/(default)/documents/admins/$(email())).data.get('role', '') == 'high_admin'
          || firestore.get(/databases/(default)/documents/admins/$(email())).data.get('role', '') == 'faculty_admin'));
    }
    function adminRole() {
      return owner() ? 'system_admin' : firestore.get(/databases/(default)/documents/admins/$(email())).data.get('role', 'admin');
    }
    function facultyAdmin() {
      return admin() && !owner() && adminRole() == 'faculty_admin';
    }
    function departmentAdmin() {
      return admin() && !owner() && adminRole() == 'department_admin';
    }
    function subAdmin() {
      return admin() && !owner() && (adminRole() == 'subadmin' || adminRole() == 'sub_admin');
    }
    function departmentScopeIds() {
      let data = firestore.get(/databases/(default)/documents/admins/$(email())).data;
      let ids = data.get('scopeIds', []);
      return ids is list && ids.size() > 0 ? ids : [data.get('scopeId', '')];
    }
    function categoryDepartment(category) {
      return category == 'Ngành Đồ họa' ? 'graphic'
        : category == 'Ngành Thiết kế công nghiệp' ? 'industrial'
        : category == 'Ngành Thiết kế nội thất' ? 'interior'
        : category == 'Ngành Thiết kế thời trang' ? 'fashion'
        : category == 'Ngành Nghệ thuật số' ? 'digital-art'
        : category == 'Sau đại học' ? 'graduate' : '';
    }
    function resourceDepartment(data) {
      return data.get('scopeType', '') == 'department' ? data.get('scopeId', '') : categoryDepartment(data.get('category', ''));
    }
    function managesResource(data) {
      return highAdmin() || facultyAdmin()
        || (departmentAdmin() && resourceDepartment(data) != '' && departmentScopeIds().hasAny([resourceDepartment(data)]))
        || ((departmentAdmin() || subAdmin()) && resourceDepartment(data) == '' && data.createdByUid == request.auth.uid)
        || (subAdmin() && data.createdByUid == request.auth.uid);
    }
    function managesSession(sessionId) {
      let session = firestore.get(/databases/(default)/documents/attendanceSessions/$(sessionId)).data;
      return session.get('attendanceType', '') == 'private'
        ? owner() || (signedIn() && session.createdByUid == request.auth.uid)
        : managesResource(session)
          || (signedIn() && session.get('coManagerUids', []).hasAny([request.auth.uid]));
    }
    function ownsPrivateSession(sessionId) {
      let session = firestore.get(/databases/(default)/documents/attendanceSessions/$(sessionId)).data;
      return session.get('attendanceType', '') == 'private'
        && (owner() || (signedIn() && session.createdByUid == request.auth.uid));
    }
    function assigned(sessionId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/scannerAssignments/$(sessionId + '_' + email()))
        && firestore.get(/databases/(default)/documents/scannerAssignments/$(sessionId + '_' + email())).data.active == true;
    }
    function eventPath(eventId) {
      return /databases/(default)/documents/events/$(eventId);
    }
    function managesEvent(eventId) {
      return firestore.exists(eventPath(eventId))
        && (managesResource(firestore.get(eventPath(eventId)).data)
        || (signedIn() && firestore.get(eventPath(eventId)).data.get('coManagerUids', []).hasAny([request.auth.uid])));
    }
    function downloadableEvent(eventId) {
      return firestore.exists(eventPath(eventId))
        && firestore.get(eventPath(eventId)).data.get('deletedAt', null) == null;
    }
    function validEventAttachmentType(attachmentFile) {
      return (attachmentFile.matches('^[A-Za-z0-9_-]{16,100}\\.pdf$') && request.resource.contentType == 'application/pdf')
        || (attachmentFile.matches('^[A-Za-z0-9_-]{16,100}\\.doc$') && request.resource.contentType == 'application/msword')
        || (attachmentFile.matches('^[A-Za-z0-9_-]{16,100}\\.docx$') && request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document')
        || (attachmentFile.matches('^[A-Za-z0-9_-]{16,100}\\.xls$') && request.resource.contentType == 'application/vnd.ms-excel')
        || (attachmentFile.matches('^[A-Za-z0-9_-]{16,100}\\.xlsx$') && request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')
        || (attachmentFile.matches('^[A-Za-z0-9_-]{16,100}\\.ppt$') && request.resource.contentType == 'application/vnd.ms-powerpoint')
        || (attachmentFile.matches('^[A-Za-z0-9_-]{16,100}\\.pptx$') && request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation')
        || (attachmentFile.matches('^[A-Za-z0-9_-]{16,100}\\.zip$') && (request.resource.contentType == 'application/zip' || request.resource.contentType == 'application/x-zip-compressed'));
    }

    match /datasets/{datasetFile} {
      allow read: if participant();
      allow create, update: if (highAdmin() || facultyAdmin())
        && datasetFile == 'faculty-students.json.gz'
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType == 'application/gzip';
      allow delete: if owner();
    }

    match /attendance/{sessionId}/{imageFile} {
      allow read: if managesSession(sessionId) || assigned(sessionId);
      allow create, update: if (managesSession(sessionId) || assigned(sessionId))
        && imageFile.matches('^[A-Za-z0-9_.-]+\\.jpg$')
        && request.resource.size < 1536 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if ownsPrivateSession(sessionId)
        || (highAdmin() && firestore.get(/databases/(default)/documents/attendanceSessions/$(sessionId)).data.get('attendanceType', '') != 'private');
    }

    match /exports/{exportType}/{exportFile} {
      allow read: if exportCacheAdmin();
      allow create, update: if exportCacheAdmin()
        && (exportType == 'registrations' || exportType == 'attendance')
        && exportFile.matches('^[A-Za-z0-9_.-]+\\.xlsx$')
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
      allow delete: if exportCacheAdmin();
    }

    match /event-attachments/{eventId}/{attachmentFile} {
      allow read: if highAdmin() || downloadableEvent(eventId);
      allow create: if managesEvent(eventId)
        && resource == null
        && request.resource.size <= 20 * 1024 * 1024
        && validEventAttachmentType(attachmentFile);
      allow update: if false;
      allow delete: if managesEvent(eventId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
